Depends: timeshift, btrfs-progs, inotify-tools, overlayroot, initramfs-tools, cron, systemd-zram-generator, grub-common, grub2-common, grub-pc-bin, grub-efi-amd64-bin, util-linux, python3, sudo, polkitd, init-system-helpers
