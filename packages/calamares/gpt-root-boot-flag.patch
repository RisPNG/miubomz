Description: Keep the legacy BIOS root boot flag off GPT Linux partitions
Author: Miubomz
Forwarded: no

--- a/src/modules/partition/core/PartitionCoreModule.cpp
+++ b/src/modules/partition/core/PartitionCoreModule.cpp
@@ -985,7 +985,7 @@
                                   PartitionNode* parent,
                                   const PartitionRole& role )
 {
-    const bool isEfi = PartUtils::isEfiSystem();
+    const bool useLegacyBootFlag = !PartUtils::isEfiSystem() && dev->partitionTable()->type() != PartitionTable::gpt;
     QList< Partition* > partList
         = m_partLayout.createPartitions( dev, firstSector, lastSector, luksFsType, luksPassphrase, parent, role );
 
@@ -993,8 +993,8 @@
     // PartitionInfo::mountPoint() says where it will be mounted in the target system.
     // .. the latter is more interesting.
     //
-    // If we have a separate /boot, mark that one as bootable,
