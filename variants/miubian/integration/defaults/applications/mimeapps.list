[Default Applications]
text/html=vivaldi-stable.desktop;
application/xhtml+xml=vivaldi-stable.desktop;
application/xhtml_xml=vivaldi-stable.desktop;
x-scheme-handler/http=vivaldi-stable.desktop;
x-scheme-handler/https=vivaldi-stable.desktop;
x-scheme-handler/about=vivaldi-stable.desktop;
x-scheme-handler/unknown=vivaldi-stable.desktop;
video/*=mpv.desktop;
application/ogg=mpv.desktop;
application/x-ogg=mpv.desktop;
application/mxf=mpv.desktop;
application/vnd.ms-asf=mpv.desktop;
application/vnd.rn-realmedia=mpv.desktop;
application/vnd.rn-realmedia-vbr=mpv.desktop;
application/x-matroska=mpv.desktop;
application/x-ogm=mpv.desktop;
application/x-ogm-video=mpv.desktop;
audio/*=harmonoid.desktop;mpv.desktop;
application/x-ogm-audio=harmonoid.desktop;mpv.desktop;
application/x-shorten=harmonoid.desktop;mpv.desktop;
application/x-extension-m4a=harmonoid.desktop;mpv.desktop;
application/vnd.apple.mpegurl=harmonoid.desktop;mpv.desktop;
application/x-mpegurl=harmonoid.desktop;mpv.desktop;
application/xspf+xml=harmonoid.desktop;mpv.desktop;
application/x-cue=harmonoid.desktop;mpv.desktop;
image/*=qview.desktop;
application/x-navi-animation=qview.desktop;
application/x-krita=qview.desktop;
application/x-photoshop=qview.desktop;
application/photoshop=qview.desktop;
application/psd=qview.desktop;
application/pdf=org.gnome.Evince.desktop;
inode/directory=org.gnome.Nautilus.desktop;
